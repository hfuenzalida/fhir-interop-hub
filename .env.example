# Copy to .env and fill in. Never commit .env.

NODE_ENV=development

# Hub API
HUB_API_HOST=0.0.0.0
HUB_API_PORT=3000

# Database (Phase 0+: append-only audit store)
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub

# OIDC / SMART — issuer/audience for JWT access tokens (defaults derived from port if unset)
OIDC_ISSUER=
OIDC_AUDIENCE=

# SMART JWT signing: either HS256 secret (min 32 chars) OR RSA PEM for RS256 + JWKS
HUB_JWT_SECRET=
# PKCS#8 private PEM (RS256). With this set, access/id tokens use RS256; /.well-known/jwks.json is served.
# HUB_JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
HUB_JWT_PRIVATE_KEY_PEM=
# Optional SPKI public PEM (verification/JWKS); else derived from private key.
HUB_JWT_PUBLIC_KEY_PEM=
# Key id for JWT kid + JWKS (change when rotating keys).
HUB_JWT_KID=

# GAP 3 — CORS: comma-separated origins, or * . Empty = dev permissive; production = no CORS until set.
CORS_ORIGINS=
# Trust X-Forwarded-* from reverse proxy (client IP for rate limits).
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_OAUTH_MAX=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ALLOW_LOOPBACK=true
FHIR_JSON_MAX_DEPTH=48
HL7_INGEST_MAX_CHARS=4000000
REQUEST_BODY_LIMIT_BYTES=11534336

# GAP 4 — Compliance / audit hooks (optional headers → audit actor JSON)
# Lowercase header names as sent on the wire; unset = defaults below.
# BREAK_GLASS_HEADER=x-break-glass-reason
# PURPOSE_OF_USE_HEADER=x-purpose-of-use
# Redact Authorization + Hub API key from Fastify request logs (default true).
LOG_REDACT_ENABLED=true

# Audit integrity (Postgres): per-tenant hash chain; optional HMAC secret for row_hash
AUDIT_INTEGRITY_ENABLED=true
# AUDIT_CHAIN_SECRET=

# FHIR Consent + purpose-of-use policy (off by default)
# CONSENT_POLICY_ENABLED=false
# CONSENT_REQUIRE_PURPOSE_HEADER=true

# GAP 5 — Pool tuning & read replica (FHIR reads only when replica URL set)
PG_POOL_MAX=20
# PG_READ_POOL_MAX=20
PG_POOL_MIN=0
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=0
# DATABASE_READ_URL=postgresql://hub:hub@localhost:5433/hub
CAPABILITY_CACHE_TTL_MS=60000
DISCOVERY_CACHE_TTL_MS=60000

# GAP 6 — Logging & Prometheus (METRICS_ENABLED=true exposes GET /internal/metrics)
# LOG_LEVEL=info
# CORRELATION_ID_HEADER=x-correlation-id
METRICS_ENABLED=true
# Production (NODE_ENV=production): if METRICS_ENABLED=true, INTERNAL_METRICS_TOKEN is required.
# INTERNAL_METRICS_TOKEN=
# METRICS_NODE_COLLECT_DEFAULT=false

# Tenant default for local dev (must exist in `tenant.external_key` after seed/migration)
DEV_TENANT_ID=dev-tenant-001

# Optional: bypass DB api_key table — use with DEV_TENANT_ID row in DB (never in NODE_ENV=production)
# DEV_API_KEY=your-long-random-secret
