{
  "name": "fhir-interop-hub",
  "private": true,
  "version": "0.0.0",
  "description": "FHIR hub + SMART apps — Phase 1 FHIR API",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:hub": "npm run dev -w @fhir-hub/hub-api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate:apply-all": "node ./scripts/apply-all-migrations.mjs",
    "seed": "node ./scripts/seed-phase1.mjs",
    "export-tenant-ndjson": "node ./scripts/export-tenant-ndjson.mjs",
    "tenant-admin": "node ./scripts/tenant-admin.mjs",
    "import-tenant-ndjson": "npm run import-ndjson -w @fhir-hub/hub-api --",
    "test": "npm run test -w @fhir-hub/hub-api",
    "test:integration": "npm run test:integration -w @fhir-hub/hub-api",
    "docker:build": "docker build -t fhir-hub-api:local .",
    "docker:compose:hub": "docker compose -f docker-compose.hub.yml up --build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
