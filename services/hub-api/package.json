{
  "name": "@fhir-hub/hub-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "import-ndjson": "node --import tsx src/cli/import-tenant-ndjson.ts",
    "test": "node --import tsx --test test/api-key.test.ts test/audit-integrity.test.ts test/ttl-cache.test.ts test/json-depth.test.ts test/metering-api-family.test.ts test/mpi.test.ts test/production-env-guardrails.test.ts test/reference-remap.test.ts test/patient-match-score.test.ts",
    "test:integration": "node --import tsx --test test/integration/hub.integration.test.ts",
    "audit:deps": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fhir-hub/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^6.2.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
